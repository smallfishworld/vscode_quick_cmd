{
  "name": "vscode-quick-cmd",
  "displayName": "Quick Cmd",
  "description": "%description%",
  "version": "0.4.0",
  "publisher": "smallfishworld",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/smallfishworld/vscode_quick_cmd.git"
  },
  "homepage": "https://github.com/smallfishworld/vscode_quick_cmd",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "Productivity"
  ],
  "keywords": [
    "commands",
    "terminal",
    "sidebar",
    "shell",
    "quick run"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:quickCmd.commands",
    "onView:quickCmd.editor"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%trust%"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quickCmd",
          "title": "Quick Cmd",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "quickCmd": [
        {
          "id": "quickCmd.commands",
          "name": "%quickCmd.commands%"
        },
        {
          "id": "quickCmd.editor",
          "name": "%quickCmd.editor%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "quickCmd.addCommand",
        "title": "%quickCmd.addCommand%",
        "icon": "$(add)"
      },
      {
        "command": "quickCmd.addGroup",
        "title": "%quickCmd.addGroup%",
        "icon": "$(new-folder)"
      },
      {
        "command": "quickCmd.refresh",
        "title": "%quickCmd.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "quickCmd.run",
        "title": "%quickCmd.run%",
        "icon": "$(play)"
      },
      {
        "command": "quickCmd.editCommand",
        "title": "%quickCmd.editCommand%",
        "icon": "$(edit)"
      },
      {
        "command": "quickCmd.deleteCommand",
        "title": "%quickCmd.deleteCommand%",
        "icon": "$(trash)"
      },
      {
        "command": "quickCmd.renameGroup",
        "title": "%quickCmd.renameGroup%",
        "icon": "$(edit)"
      },
      {
        "command": "quickCmd.deleteGroup",
        "title": "%quickCmd.deleteGroup%",
        "icon": "$(trash)"
      },
      {
        "command": "quickCmd.openConfig",
        "title": "%quickCmd.openConfig%",
        "icon": "$(json)"
      },
      {
        "command": "quickCmd.duplicateCommand",
        "title": "%quickCmd.duplicateCommand%",
        "icon": "$(copy)"
      },
      {
        "command": "quickCmd.moveCommandUp",
        "title": "%quickCmd.moveCommandUp%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "quickCmd.moveCommandDown",
        "title": "%quickCmd.moveCommandDown%",
        "icon": "$(arrow-down)"
      },
      {
        "command": "quickCmd.moveGroupUp",
        "title": "%quickCmd.moveGroupUp%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "quickCmd.moveGroupDown",
        "title": "%quickCmd.moveGroupDown%",
        "icon": "$(arrow-down)"
      },
      {
        "command": "quickCmd.exportConfig",
        "title": "%quickCmd.exportConfig%",
        "icon": "$(export)"
      },
      {
        "command": "quickCmd.importConfig",
        "title": "%quickCmd.importConfig%",
        "icon": "$(import)"
      },
      {
        "command": "quickCmd.searchCommands",
        "title": "%quickCmd.searchCommands%",
        "icon": "$(search)"
      },
      {
        "command": "quickCmd.runById",
        "title": "%quickCmd.runById%",
        "icon": "$(play)"
      },
      {
        "command": "quickCmd.copyShortcut",
        "title": "%quickCmd.copyShortcut%",
        "icon": "$(keyboard)"
      },
      {
        "command": "quickCmd.stop",
        "title": "%quickCmd.stop%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "quickCmd.openEditorPanel",
        "title": "%quickCmd.openEditorPanel%",
        "icon": "$(open-in-editor)"
      },
      {
        "command": "quickCmd.selectCommand",
        "title": "%quickCmd.selectCommand%",
        "icon": "$(edit)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "quickCmd.addCommand",
          "when": "view == quickCmd.commands",
          "group": "navigation@1"
        },
        {
          "command": "quickCmd.addGroup",
          "when": "view == quickCmd.commands",
          "group": "manage"
        },
        {
          "command": "quickCmd.refresh",
          "when": "view == quickCmd.commands",
          "group": "manage"
        },
        {
          "command": "quickCmd.searchCommands",
          "when": "view == quickCmd.commands",
          "group": "navigation@0"
        },
        {
          "command": "quickCmd.openEditorPanel",
          "when": "view == quickCmd.editor",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "quickCmd.run",
          "when": "view == quickCmd.commands && viewItem == quickCmd.command",
          "group": "inline@1"
        },
        {
          "command": "quickCmd.editCommand",
          "when": "view == quickCmd.commands && viewItem == quickCmd.command",
          "group": "inline@2"
        },
        {
          "command": "quickCmd.deleteCommand",
          "when": "view == quickCmd.commands && viewItem == quickCmd.command",
          "group": "navigation@3"
        },
        {
          "command": "quickCmd.addCommand",
          "when": "view == quickCmd.commands && viewItem == quickCmd.group",
          "group": "inline@1"
        },
        {
          "command": "quickCmd.renameGroup",
          "when": "view == quickCmd.commands && viewItem == quickCmd.group",
          "group": "navigation@2"
        },
        {
          "command": "quickCmd.deleteGroup",
          "when": "view == quickCmd.commands && viewItem == quickCmd.group",
          "group": "navigation@3"
        },
        {
          "command": "quickCmd.addGroup",
          "when": "view == quickCmd.commands && viewItem =~ /^quickCmd\\.scope/",
          "group": "inline@1"
        },
        {
          "command": "quickCmd.openConfig",
          "when": "view == quickCmd.commands && viewItem == quickCmd.scope.workspace",
          "group": "navigation@2"
        },
        {
          "command": "quickCmd.duplicateCommand",
          "when": "view == quickCmd.commands && viewItem == quickCmd.command",
          "group": "navigation@4"
        },
        {
          "command": "quickCmd.moveCommandUp",
          "when": "view == quickCmd.commands && viewItem == quickCmd.command",
          "group": "navigation@5"
        },
        {
          "command": "quickCmd.moveCommandDown",
          "when": "view == quickCmd.commands && viewItem == quickCmd.command",
          "group": "navigation@6"
        },
        {
          "command": "quickCmd.copyShortcut",
          "when": "view == quickCmd.commands && viewItem == quickCmd.command",
          "group": "navigation@7"
        },
        {
          "command": "quickCmd.stop",
          "when": "view == quickCmd.commands && viewItem == quickCmd.command",
          "group": "navigation@8"
        },
        {
          "command": "quickCmd.moveGroupUp",
          "when": "view == quickCmd.commands && viewItem == quickCmd.group",
          "group": "navigation@4"
        },
        {
          "command": "quickCmd.moveGroupDown",
          "when": "view == quickCmd.commands && viewItem == quickCmd.group",
          "group": "navigation@5"
        },
        {
          "command": "quickCmd.importConfig",
          "when": "view == quickCmd.commands && viewItem =~ /^quickCmd\\.scope/",
          "group": "navigation@3"
        },
        {
          "command": "quickCmd.exportConfig",
          "when": "view == quickCmd.commands && viewItem =~ /^quickCmd\\.scope/",
          "group": "navigation@4"
        },
        {
          "command": "quickCmd.run",
          "when": "view == quickCmd.commands && viewItem == quickCmd.command",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Quick Cmd",
      "properties": {
        "quickCmd.shellType": {
          "type": "string",
          "enum": [
            "auto",
            "posix",
            "powershell",
            "cmd"
          ],
          "default": "auto",
          "description": "%shellType%"
        },
        "quickCmd.singleClickRuns": {
          "type": "boolean",
          "default": false,
          "description": "%singleClickRuns%"
        }
      }
    },
    "keybindings": [
      {
        "command": "quickCmd.searchCommands",
        "key": "ctrl+alt+q",
        "mac": "cmd+alt+q",
        "when": "editorTextFocus || view == quickCmd.commands"
      }
    ]
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/i18n.js && node --check media/i18n.js && node --check src/model.js && node --check src/store.js && node --check src/tree.js && node --check src/variables.js && node --check src/terminal.js && node --check src/transfer.js && node --check src/extension.js && node --check src/editor.js && node --check media/editor-client.js",
    "package": "npx --yes @vscode/vsce package --out quick-cmd.vsix"
  },
  "devDependencies": {
    "happy-dom": "21.0.1"
  }
}
