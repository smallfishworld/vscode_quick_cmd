{
  "name": "vscode-quick-cmd",
  "displayName": "Quick Cmd",
  "description": "Manage, search, and execute saved shell commands from the VS Code sidebar.",
  "version": "0.2.0",
  "publisher": "smallfishworld",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/smallfishworld/vscode_quick_cmd.git"
  },
  "homepage": "https://github.com/smallfishworld/vscode_quick_cmd",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "Productivity"
  ],
  "keywords": [
    "commands",
    "terminal",
    "sidebar",
    "shell",
    "quick run"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:quickCmd.commands"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Saved commands can be viewed and edited, but they cannot run until the workspace is trusted."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quickCmd",
          "title": "Quick Cmd",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "quickCmd": [
        {
          "id": "quickCmd.commands",
          "name": "Commands"
        }
      ]
    },
    "commands": [
      {
        "command": "quickCmd.addCommand",
        "title": "Quick Cmd: Add Command",
        "icon": "$(add)"
      },
      {
        "command": "quickCmd.addGroup",
        "title": "Quick Cmd: Add Group",
        "icon": "$(new-folder)"
      },
      {
        "command": "quickCmd.refresh",
        "title": "Quick Cmd: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "quickCmd.run",
        "title": "Quick Cmd: Run",
        "icon": "$(play)"
      },
      {
        "command": "quickCmd.editCommand",
        "title": "Quick Cmd: Edit Command",
        "icon": "$(edit)"
      },
      {
        "command": "quickCmd.deleteCommand",
        "title": "Quick Cmd: Delete Command",
        "icon": "$(trash)"
      },
      {
        "command": "quickCmd.renameGroup",
        "title": "Quick Cmd: Rename Group",
        "icon": "$(edit)"
      },
      {
        "command": "quickCmd.deleteGroup",
        "title": "Quick Cmd: Delete Group",
        "icon": "$(trash)"
      },
      {
        "command": "quickCmd.openConfig",
        "title": "Quick Cmd: Open Workspace Configuration",
        "icon": "$(json)"
      },
      {
        "command": "quickCmd.duplicateCommand",
        "title": "Quick Cmd: Duplicate Command",
        "icon": "$(copy)"
      },
      {
        "command": "quickCmd.moveCommandUp",
        "title": "Quick Cmd: Move Command Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "quickCmd.moveCommandDown",
        "title": "Quick Cmd: Move Command Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "quickCmd.moveGroupUp",
        "title": "Quick Cmd: Move Group Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "quickCmd.moveGroupDown",
        "title": "Quick Cmd: Move Group Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "quickCmd.exportConfig",
        "title": "Quick Cmd: Export JSON Configuration",
        "icon": "$(export)"
      },
      {
        "command": "quickCmd.importConfig",
        "title": "Quick Cmd: Import JSON Configuration",
        "icon": "$(cloud-download)"
      },
      {
        "command": "quickCmd.searchCommands",
        "title": "Quick Cmd: Search Commands",
        "icon": "$(search)"
      },
      {
        "command": "quickCmd.runById",
        "title": "Quick Cmd: Run Command by ID",
        "icon": "$(play)"
      },
      {
        "command": "quickCmd.copyShortcut",
        "title": "Quick Cmd: Copy Keybinding Snippet",
        "icon": "$(keyboard)"
      },
      {
        "command": "quickCmd.stop",
        "title": "Quick Cmd: Stop Command (Close Terminal)",
        "icon": "$(debug-stop)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "quickCmd.addCommand",
          "when": "view == quickCmd.commands",
          "group": "navigation@1"
        },
        {
          "command": "quickCmd.addGroup",
          "when": "view == quickCmd.commands",
          "group": "navigation@2"
        },
        {
          "command": "quickCmd.refresh",
          "when": "view == quickCmd.commands",
          "group": "navigation@3"
        },
        {
          "command": "quickCmd.searchCommands",
          "when": "view == quickCmd.commands",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "quickCmd.run",
          "when": "view == quickCmd.commands && viewItem == quickCmd.command",
          "group": "inline@1"
        },
        {
          "command": "quickCmd.editCommand",
          "when": "view == quickCmd.commands && viewItem == quickCmd.command",
          "group": "navigation@2"
        },
        {
          "command": "quickCmd.deleteCommand",
          "when": "view == quickCmd.commands && viewItem == quickCmd.command",
          "group": "navigation@3"
        },
        {
          "command": "quickCmd.addCommand",
          "when": "view == quickCmd.commands && viewItem == quickCmd.group",
          "group": "inline@1"
        },
        {
          "command": "quickCmd.renameGroup",
          "when": "view == quickCmd.commands && viewItem == quickCmd.group",
          "group": "navigation@2"
        },
        {
          "command": "quickCmd.deleteGroup",
          "when": "view == quickCmd.commands && viewItem == quickCmd.group",
          "group": "navigation@3"
        },
        {
          "command": "quickCmd.addGroup",
          "when": "view == quickCmd.commands && viewItem =~ /^quickCmd\\.scope/",
          "group": "inline@1"
        },
        {
          "command": "quickCmd.openConfig",
          "when": "view == quickCmd.commands && viewItem == quickCmd.scope.workspace",
          "group": "navigation@2"
        },
        {
          "command": "quickCmd.duplicateCommand",
          "when": "view == quickCmd.commands && viewItem == quickCmd.command",
          "group": "navigation@4"
        },
        {
          "command": "quickCmd.moveCommandUp",
          "when": "view == quickCmd.commands && viewItem == quickCmd.command",
          "group": "navigation@5"
        },
        {
          "command": "quickCmd.moveCommandDown",
          "when": "view == quickCmd.commands && viewItem == quickCmd.command",
          "group": "navigation@6"
        },
        {
          "command": "quickCmd.copyShortcut",
          "when": "view == quickCmd.commands && viewItem == quickCmd.command",
          "group": "navigation@7"
        },
        {
          "command": "quickCmd.stop",
          "when": "view == quickCmd.commands && viewItem == quickCmd.command",
          "group": "navigation@8"
        },
        {
          "command": "quickCmd.moveGroupUp",
          "when": "view == quickCmd.commands && viewItem == quickCmd.group",
          "group": "navigation@4"
        },
        {
          "command": "quickCmd.moveGroupDown",
          "when": "view == quickCmd.commands && viewItem == quickCmd.group",
          "group": "navigation@5"
        },
        {
          "command": "quickCmd.importConfig",
          "when": "view == quickCmd.commands && viewItem =~ /^quickCmd\\.scope/",
          "group": "navigation@3"
        },
        {
          "command": "quickCmd.exportConfig",
          "when": "view == quickCmd.commands && viewItem =~ /^quickCmd\\.scope/",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "Quick Cmd",
      "properties": {
        "quickCmd.shellType": {
          "type": "string",
          "enum": [
            "auto",
            "posix",
            "powershell",
            "cmd"
          ],
          "default": "auto",
          "description": "Shell quoting mode used when interpolating command variables. Auto uses PowerShell or cmd.exe on Windows and POSIX quoting elsewhere."
        }
      }
    },
    "keybindings": [
      {
        "command": "quickCmd.searchCommands",
        "key": "ctrl+alt+q",
        "mac": "cmd+alt+q",
        "when": "editorTextFocus || view == quickCmd.commands"
      }
    ]
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/model.js && node --check src/store.js && node --check src/tree.js && node --check src/variables.js && node --check src/terminal.js && node --check src/transfer.js && node --check src/extension.js",
    "package": "npx --yes @vscode/vsce package --out quick-cmd.vsix"
  }
}
